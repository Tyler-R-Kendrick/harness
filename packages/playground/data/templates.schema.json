{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "decision": {
      "type": "object",
      "properties": {
        "accept": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maxOptions": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "none": {
          "type": "string",
          "minLength": 1
        },
        "rotate": {
          "type": "boolean"
        },
        "keep": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "accept",
        "maxOptions",
        "question",
        "none",
        "rotate",
        "keep"
      ],
      "additionalProperties": false
    },
    "lexical": {
      "type": "object",
      "properties": {
        "accept": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "none": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "temperature": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "stopwords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "accept",
        "none",
        "temperature",
        "stopwords"
      ],
      "additionalProperties": false
    },
    "choice": {
      "type": "object",
      "properties": {
        "gpuBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "headroom": {
          "type": "number",
          "minimum": 1
        }
      },
      "required": [
        "gpuBytes",
        "headroom"
      ],
      "additionalProperties": false
    },
    "curation": {
      "type": "object",
      "properties": {
        "retireMargin": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "retireMargin"
      ],
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "properties": {
        "write": {
          "type": "string",
          "minLength": 1
        },
        "fill": {
          "type": "string",
          "minLength": 1
        },
        "refine": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "answerTokens": {
          "type": "integer",
          "minimum": 16,
          "maximum": 9007199254740991
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 64,
          "maximum": 9007199254740991
        },
        "trialMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 9007199254740991
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 8,
              "maximum": 9007199254740991
            },
            "text": {
              "type": "integer",
              "minimum": 16,
              "maximum": 9007199254740991
            },
            "body": {
              "type": "integer",
              "minimum": 16,
              "maximum": 9007199254740991
            },
            "examples": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "id",
            "text",
            "body",
            "examples"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "write",
        "fill",
        "refine",
        "answer",
        "answerTokens",
        "maxTokens",
        "trialMs",
        "examples",
        "limits"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "decision",
    "lexical",
    "choice",
    "curation",
    "generation"
  ],
  "additionalProperties": false
}
