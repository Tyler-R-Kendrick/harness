{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "fuzzMinTrials": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "mutationBreak": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "maxCrap": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "agents": {
      "minItems": 8,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "fuzz",
              "mutation",
              "crap",
              "contract",
              "atomic",
              "evals",
              "bdd",
              "ux"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "instructions": {
            "type": "string",
            "minLength": 1
          },
          "applies": {
            "type": "string",
            "enum": [
              "always",
              "boundary",
              "ui"
            ]
          }
        },
        "required": [
          "name",
          "title",
          "instructions",
          "applies"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "fuzzMinTrials",
    "mutationBreak",
    "maxCrap",
    "agents"
  ],
  "additionalProperties": false
}
