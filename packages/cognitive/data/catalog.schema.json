{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "tasks": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "judgment",
                "classification",
                "tool-calling",
                "structured-extraction",
                "text-embedding",
                "prompt-compression",
                "chat",
                "reasoning",
                "coding",
                "vision-qa",
                "ocr",
                "document-parsing",
                "table-extraction",
                "chart-understanding",
                "steered-chat"
              ]
            }
          },
          "ports": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "judge",
                "router",
                "embedder",
                "compressor",
                "generator",
                "document-parser"
              ]
            }
          },
          "locality": {
            "type": "string",
            "enum": [
              "local",
              "hosted"
            ]
          },
          "runtime": {
            "type": "string",
            "enum": [
              "ai-gateway",
              "needle-wasm",
              "transformers.js",
              "llama.cpp-server",
              "onnxruntime",
              "clm-serve"
            ]
          },
          "platforms": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "native",
                "browser"
              ]
            }
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "downloadBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "notes": {
            "type": "string"
          },
          "artifact": {
            "type": "object",
            "properties": {
              "repo": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "files": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "bytes": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "path",
                    "bytes",
                    "sha256"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "repo",
              "revision",
              "files"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "publisher",
          "tasks",
          "ports",
          "locality",
          "runtime",
          "platforms",
          "license",
          "downloadBytes"
        ],
        "additionalProperties": false
      }
    },
    "preferences": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "judgment",
          "classification",
          "tool-calling",
          "structured-extraction",
          "text-embedding",
          "prompt-compression",
          "chat",
          "reasoning",
          "coding",
          "vision-qa",
          "ocr",
          "document-parsing",
          "table-extraction",
          "chart-understanding",
          "steered-chat"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "required": [
    "models",
    "preferences"
  ],
  "additionalProperties": false
}
