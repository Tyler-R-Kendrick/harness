{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "readOnly": true,
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "readOnly": true,
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "layer"
      ],
      "additionalProperties": false
    },
    "initial": {
      "type": "string",
      "minLength": 1
    },
    "maxStrength": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "features": {
      "readOnly": true,
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "sensors": {
      "readOnly": true,
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "readOnly": true,
        "type": "object",
        "properties": {
          "feature": {
            "type": "string",
            "minLength": 1
          },
          "on": {
            "type": "number"
          },
          "off": {
            "type": "number"
          },
          "hold": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "feature",
          "on",
          "off"
        ],
        "additionalProperties": false
      }
    },
    "states": {
      "readOnly": true,
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "readOnly": true,
        "type": "object",
        "properties": {
          "parent": {
            "type": "string",
            "minLength": 1
          },
          "steer": {
            "readOnly": true,
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "transitions": {
      "readOnly": true,
      "type": "array",
      "items": {
        "readOnly": true,
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "anyOf": [
              {
                "readOnly": true,
                "type": "object",
                "properties": {
                  "sensor": {
                    "type": "string",
                    "minLength": 1
                  },
                  "is": {
                    "type": "string",
                    "enum": [
                      "on",
                      "off"
                    ]
                  }
                },
                "required": [
                  "sensor",
                  "is"
                ],
                "additionalProperties": false
              },
              {
                "readOnly": true,
                "type": "object",
                "properties": {
                  "event": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "event"
                ],
                "additionalProperties": false
              },
              {
                "readOnly": true,
                "type": "object",
                "properties": {
                  "after": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "after"
                ],
                "additionalProperties": false
              }
            ]
          },
          "priority": {
            "type": "number"
          }
        },
        "required": [
          "from",
          "to",
          "when"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "id",
    "model",
    "initial",
    "features",
    "sensors",
    "states",
    "transitions"
  ],
  "additionalProperties": false
}
