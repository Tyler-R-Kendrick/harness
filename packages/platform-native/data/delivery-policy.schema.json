{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "maxExtraDiskBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "minFreeDiskBytes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "maxMemoryBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "gpu": {
      "type": "string",
      "enum": [
        "deny",
        "allow"
      ]
    },
    "timeoutMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "maxWorktrees": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "maxExtraDiskBytes",
    "minFreeDiskBytes",
    "maxMemoryBytes",
    "maxTokens",
    "gpu",
    "timeoutMs",
    "maxWorktrees"
  ],
  "additionalProperties": false
}
