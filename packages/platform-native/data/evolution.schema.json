{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "documents": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "json"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "schema": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "text"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "component": {
                "type": "string",
                "minLength": 1
              },
              "regions": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "pattern": {
                      "type": "string",
                      "minLength": 1
                    },
                    "component": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "pattern",
                    "component"
                  ],
                  "additionalProperties": false
                }
              },
              "check": {
                "type": "object",
                "properties": {
                  "command": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "cwd": {
                    "type": "string",
                    "minLength": 1
                  },
                  "timeoutMs": {
                    "default": 10000,
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "env": {
                    "type": "object",
                    "properties": {
                      "allow": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                        }
                      },
                      "set": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string",
                          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                        },
                        "additionalProperties": {
                          "type": "string"
                        }
                      }
                    },
                    "additionalProperties": false,
                    "description": "The command's whole environment: never the parent's. Only PATH, HOME, LANG, LC_ALL, TMPDIR and TERM are copied from the parent (so credentials such as AI_GATEWAY_API_KEY are not visible to the command); allow names more variables to copy, set gives literal values."
                  }
                },
                "required": [
                  "command"
                ],
                "additionalProperties": false,
                "description": "A liveness command run synchronously (it blocks the run for at most timeoutMs). It runs in a process group of its own, which is killed at the time limit and after every run; the direct child is killed with SIGKILL and its output is bounded to 64 KiB. Limits: a process that made its own session or process group (setsid) escapes, on Windows only the direct child is killed, and a signal to the harness-evolution process is handled only after the check returns."
              }
            },
            "required": [
              "kind",
              "path"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "components": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "structural": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "classify": {
      "default": {
        "rules": []
      },
      "type": "object",
      "properties": {
        "rules": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "document": {
                "type": "string",
                "minLength": 1
              },
              "prefix": {
                "type": "string",
                "pattern": "^(\\/.*)?$"
              },
              "component": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "prefix",
              "component"
            ],
            "additionalProperties": false
          }
        },
        "fallback": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "object",
      "properties": {
        "evolve": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "group": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "holdout": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "group": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "evolve"
      ],
      "additionalProperties": false
    },
    "evaluator": {
      "type": "object",
      "properties": {
        "command": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "The evaluator's argv. It runs in a process group of its own, which is killed (SIGTERM, then SIGKILL) when it times out, overflows its output limit, or the harness-evolution process exits or is signalled; a process that made its own session escapes, and on Windows only the direct child is killed."
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "timeoutMs": {
          "default": 600000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "concurrency": {
          "default": 2,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxOutputBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 268435456,
          "description": "The most the evaluator may write to stdout, in bytes (default 67108864, 64 MiB; at most 268435456). An evaluator that writes more is killed with its process group and the evaluation fails."
        },
        "env": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            },
            "set": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "description": "The command's whole environment: never the parent's. Only PATH, HOME, LANG, LC_ALL, TMPDIR and TERM are copied from the parent (so credentials such as AI_GATEWAY_API_KEY are not visible to the command); allow names more variables to copy, set gives literal values."
        }
      },
      "required": [
        "command"
      ],
      "additionalProperties": false
    },
    "settings": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "documents",
    "components",
    "tasks",
    "evaluator"
  ],
  "additionalProperties": false
}
