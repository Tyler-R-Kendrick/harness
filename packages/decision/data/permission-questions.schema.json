{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "chars": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "questions": {
      "type": "object",
      "properties": {
        "irreversible": {
          "type": "object",
          "properties": {
            "instructions": {
              "type": "string",
              "minLength": 1
            },
            "criteria": {
              "type": "object",
              "properties": {
                "true": {
                  "type": "string",
                  "minLength": 1
                },
                "false": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "instructions"
          ],
          "additionalProperties": false
        },
        "costs": {
          "type": "object",
          "properties": {
            "instructions": {
              "type": "string",
              "minLength": 1
            },
            "criteria": {
              "type": "object",
              "properties": {
                "true": {
                  "type": "string",
                  "minLength": 1
                },
                "false": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "instructions"
          ],
          "additionalProperties": false
        },
        "visible": {
          "type": "object",
          "properties": {
            "instructions": {
              "type": "string",
              "minLength": 1
            },
            "criteria": {
              "type": "object",
              "properties": {
                "true": {
                  "type": "string",
                  "minLength": 1
                },
                "false": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "instructions"
          ],
          "additionalProperties": false
        },
        "risk": {
          "type": "object",
          "properties": {
            "instructions": {
              "type": "string",
              "minLength": 1
            },
            "levels": {
              "minItems": 4,
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "instructions",
            "levels"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "irreversible",
        "costs",
        "visible",
        "risk"
      ],
      "additionalProperties": false
    },
    "combine": {
      "type": "object",
      "properties": {
        "yesAt": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "carefulAt": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "criticalAt": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        }
      },
      "required": [
        "yesAt",
        "carefulAt",
        "criticalAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "chars",
    "questions",
    "combine"
  ],
  "additionalProperties": false
}
