{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fork": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "member": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "calibrator": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "identity"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "temperature"
                  },
                  "temperature": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "kind",
                  "temperature"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "platt"
                  },
                  "a": {
                    "type": "number"
                  },
                  "b": {
                    "type": "number"
                  }
                },
                "required": [
                  "kind",
                  "a",
                  "b"
                ],
                "additionalProperties": false
              }
            ]
          },
          "fitted": {
            "type": "object",
            "properties": {
              "n": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "at": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "eceBefore": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "eceAfter": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "brierBefore": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "brierAfter": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              }
            },
            "required": [
              "n",
              "at",
              "eceBefore",
              "eceAfter",
              "brierBefore",
              "brierAfter"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "fork",
          "member",
          "version",
          "question",
          "calibrator",
          "fitted"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "entries"
  ],
  "additionalProperties": false
}
