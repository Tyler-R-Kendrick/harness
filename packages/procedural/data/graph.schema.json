{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "readOnly": true,
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "const": "harness.procedural-graph/v1"
    },
    "nodeTypes": {
      "readOnly": true,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "relations": {
      "readOnly": true,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "nodes": {
      "readOnly": true,
      "type": "array",
      "items": {
        "readOnly": true,
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "type": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "description": {
            "type": "string"
          },
          "binding": {
            "oneOf": [
              {
                "readOnly": true,
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "tool"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "kind",
                  "name"
                ],
                "additionalProperties": false
              },
              {
                "readOnly": true,
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "workflow"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "name",
                  "code"
                ],
                "additionalProperties": false
              },
              {
                "readOnly": true,
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "skill"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "content": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "name",
                  "content"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "type",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "readOnly": true,
      "type": "array",
      "items": {
        "readOnly": true,
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "relation": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "to": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "condition": {
            "type": [
              "string",
              "null"
            ]
          },
          "guidance": {
            "type": "string"
          },
          "pitfalls": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "relation",
          "to",
          "condition",
          "guidance",
          "pitfalls"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "nodeTypes",
    "relations",
    "nodes",
    "edges"
  ],
  "additionalProperties": false
}
