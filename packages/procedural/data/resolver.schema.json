{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "when": {
            "type": "object",
            "properties": {
              "meta": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "cwdUnder": {
                "type": "string",
                "minLength": 1
              },
              "principal": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "graph": {
            "type": [
              "string",
              "null"
            ]
          },
          "route": {
            "type": "object",
            "properties": {
              "candidates": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 200,
                      "pattern": "^[a-z0-9][a-z0-9._/-]*$"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "graph": {
                          "type": "string",
                          "maxLength": 200,
                          "pattern": "^[a-z0-9][a-z0-9._/-]*$"
                        },
                        "description": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "graph",
                        "description"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "minConfidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "candidates",
              "minConfidence"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "when"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "rules"
  ],
  "additionalProperties": false
}
