{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "when": {
            "type": "object",
            "properties": {
              "meta": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "cwdUnder": {
                "type": "string",
                "minLength": 1
              },
              "principal": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "graph": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "when",
          "graph"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "rules"
  ],
  "additionalProperties": false
}
