{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "instructions": {
      "type": "string",
      "minLength": 1
    },
    "scorer": {
      "type": "string",
      "enum": [
        "exact",
        "normalized-exact",
        "f1",
        "judge"
      ]
    },
    "judge": {
      "type": "object",
      "properties": {
        "instructions": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "instructions"
      ],
      "additionalProperties": false
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "tasks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string"
          },
          "split": {
            "type": "string",
            "enum": [
              "train",
              "validation"
            ]
          }
        },
        "required": [
          "id",
          "prompt",
          "split"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "scorer",
    "tasks"
  ],
  "additionalProperties": false
}
