{
  "name": "harness",
  "private": true,
  "version": "0.0.0",
  "description": "Agent-session multiplexer daemon: portable core, platform layers, ACP everywhere, hook-driven plugin actors.",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "eval": "node packages/evals/src/cli.ts",
    "check": "npm run typecheck && npm run lint && npm run test:coverage",
    "test:models": "vitest run --config vitest.models.config.ts"
  },
  "devDependencies": {
    "@fast-check/vitest": "0.5.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
